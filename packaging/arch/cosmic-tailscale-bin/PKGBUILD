# Maintainer: Christopher Murray <lee.christopher.murray@gmail.com>
#
# The prebuilt release tarball, built and tested by the project's CI. The
# release workflow fills in pkgver and sha256sums before publishing to the AUR.

pkgname=cosmic-tailscale-bin
_pkgname=cosmic-tailscale
pkgver=0.1.0
pkgrel=1
pkgdesc='Tailscale client and panel applet for the COSMIC desktop (prebuilt)'
arch=('x86_64')
url='https://github.com/leechristophermurray/tailscale-cosmic-client'
license=('MPL-2.0')
# wayland is loaded with dlopen, so namcap cannot see it.
depends=('gcc-libs' 'glibc' 'libxkbcommon' 'wayland')
optdepends=('tailscale: the daemon this client manages'
            'cosmic-terminal: open Tailscale SSH sessions'
            'cosmic-files: browse mounted machines'
            'gvfs: mount machines over SFTP'
            'openssh: mount machines over SFTP')
provides=("$_pkgname")
conflicts=("$_pkgname")
source=("$url/releases/download/v$pkgver/$_pkgname-$pkgver-x86_64-linux.tar.gz")
sha256sums=('SKIP')

package() {
    cd "$_pkgname-$pkgver-x86_64-linux"
    ./install.sh --prefix /usr --destdir "$pkgdir"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
